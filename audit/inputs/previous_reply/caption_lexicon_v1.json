{
  "version": "AAR-caption-lexicon-v1",
  "analysis_status": "new_exploratory_post_review",
  "construction": "Defined from the 31 descriptor names before computing this version’s group frequencies. Analyst had access to prior plots and previous word counts. Not blinded or preregistered.",
  "unit": "caption-level presence of an affirmative lexical match, with negative/ambiguous matches retained separately",
  "normalization": "Unicode NFKC, lowercase, Unicode dashes to ASCII hyphen",
  "negation": "Within the same punctuation-delimited clause: negation markers no/not/without/lack/lacking/absence/absent/never and adversatives but/however reset. Coordinated phrases retain negation. Not only is not treated as negation. Heuristic; audited matched contexts are retained.",
  "features": [
    {
      "feature": "brightness",
      "group": "photography",
      "status": "exploratory_lexical_proxy",
      "patterns": [
        "\\bbright(?:ness|ly|er)?\\b",
        "\\bwell[- ]lit\\b",
        "\\bhigh[- ]key\\b"
      ],
      "note": "Menzioni di luminosità; non stima della luminanza media dei pixel."
    },
    {
      "feature": "contrast",
      "group": "photography",
      "status": "exploratory_lexical_proxy",
      "patterns": [
        "\\bcontrast(?:y)?\\b"
      ],
      "note": "Menzione del contrasto, senza dedurre un valore numerico o la direzione alto/basso."
    },
    {
      "feature": "saturation",
      "group": "photography",
      "status": "exploratory_lexical_proxy",
      "patterns": [
        "\\bsaturat(?:ed|ion)\\b"
      ],
      "note": "Menzione di saturazione; non metrica cromatica dell’immagine."
    },
    {
      "feature": "colorfulness",
      "group": "photography",
      "status": "exploratory_lexical_proxy",
      "patterns": [
        "\\bcolou?rful\\b",
        "\\bmulticolou?red\\b",
        "\\bmulti[- ]colou?red\\b",
        "\\bvivid colou?rs?\\b"
      ],
      "note": "Lessico condiviso con colourful: le due variabili lessicali non sono evidenze indipendenti."
